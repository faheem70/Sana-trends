# MongoDB connection string (from MongoDB Atlas)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/sanatrends?retryWrites=true&w=majority

# Secret used to sign admin JWT tokens - make this long & random
JWT_SECRET=change_this_to_a_long_random_string

# Admin login credentials (used by the seed script to create the admin account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Port the server listens on (Render sets this automatically in production)
PORT=5000

# URL of the deployed frontend, for CORS (e.g. https://sanatrends.vercel.app)
CLIENT_URL=http://localhost:5173
